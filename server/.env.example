# =============================================
# Blog Application - Environment Variables
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ---------------------------
# Database (Neon PostgreSQL)
# ---------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-mute-dream-b366v2ky-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=npg_yg8xhcjFwuv7

# ---------------------------
# JWT Configuration
# ---------------------------
# Secret must be at least 32 characters long (256 bits) for HS256
JWT_SECRET=blogapp-super-secret-key-change-this-in-production-32chars
# Token expiry in milliseconds (default: 3600000 = 1 hour)
JWT_EXPIRATION=3600000

# ---------------------------
# CORS - Frontend URL
# ---------------------------
# Local development
FRONTEND_URL=http://localhost:5173
# For production, replace with your deployed frontend URL e.g.:
# FRONTEND_URL=https://your-app.vercel.app
